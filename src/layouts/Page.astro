---
// About, Now: a Markdown page from src/content/pages/.
import { getEntry, render } from 'astro:content';
import Base, { type Nav } from './Base.astro';
import { formatLong, isoDate } from '../lib/posts';

interface Props {
  id: string;
  current: Nav;
}
const { id, current } = Astro.props;
const page = await getEntry('pages', id);
if (!page) throw new Error(`Missing src/content/pages/${id}.md`);
const { Content } = await render(page);
const { title, description, updated } = page.data;
---

<Base title={title} description={description} current={current}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      {
        updated && (
          <p class="meta">
            Updated <time datetime={isoDate(updated)}>{formatLong(updated)}</time>
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
